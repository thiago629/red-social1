# Copia este archivo como .env y rellena con los datos del proyecto de Supabase (región Frankfurt).
# La clave "anon" es pública por diseño: la seguridad la ponen las reglas RLS de la base de datos.
# NUNCA pongas aquí la clave "service_role" ni claves de IA: esas van solo en el servidor.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
